{
  "name": "coursework",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "start": "npm run dev",
    "build": "node --env-file-if-exists=.env scripts/build.mjs",
    "test": "node --test test/unit.test.js",
    "test:rules": "firebase emulators:exec --project demo-coursework --only auth,firestore 'node --test --test-concurrency=1 test/rules.test.js test/auth.test.js'"
  },
  "dependencies": {
    "firebase": "^12.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "esbuild": "^0.28.2",
    "firebase-tools": "^15.30.0"
  }
}
